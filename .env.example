# Lokasi database SQLite (relatif terhadap folder prisma/)
DATABASE_URL="file:../data/ujian.db"

# Password akun admin hasil seed (admin.utama, admin.x, admin.xi)
ADMIN_PASSWORD="BinaTaruna2026"

# Toleransi waktu (menit). Produksi: 1 dan 15.
# Untuk demo, toleransi kumpul boleh dipendekkan (mis. 3) agar segmen aturan waktu tidak menunggu 15 menit.
TOLERANSI_EDIT_MENIT=1
TOLERANSI_KUMPUL_MENIT=3
